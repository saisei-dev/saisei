#!/usr/bin/env bash
# Pre-commit hook: the Rust workspace must be formatted before any commit is
# allowed.
#
# Enable once per clone:   git config core.hooksPath .githooks
#
# A green commit here means a green CI.
set -euo pipefail

if ! command -v cargo >/dev/null 2>&1; then
    echo "pre-commit: cargo not found — install Rust (https://rustup.rs)." >&2
    exit 1
fi

cd "$(git rev-parse --show-toplevel)"

echo "pre-commit: cargo fmt --check..."
if ! cargo fmt --all --check; then
    echo >&2
    echo "pre-commit: unformatted code (above). Run 'cargo fmt --all' and re-commit." >&2
    exit 1
fi
