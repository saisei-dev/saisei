[flake8]
# Project style policy — enforced in CI (see .github/workflows/ci.yml) and
# locally via the pre-commit hook (.githooks/pre-commit) and `make lint`.
max-line-length = 100

# E203 (whitespace before ':') is the one check pycodestyle itself documents as
# incompatible with PEP 8 slice notation / black. It is the only rule relaxed
# here; everything else is fixed in the code, not silenced.
extend-ignore = E203

exclude =
    .git,
    __pycache__,
    build,
    crashes,
    .venv,
    venv
